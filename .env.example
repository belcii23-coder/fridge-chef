# Copy this file to ".env" and paste your key. Never share or commit the real .env file.

# FREE option (recommended): Google Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Paid option: Claude. Only needed if you want to use Claude instead.
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: force one provider if both keys are set ("gemini" or "claude")
# AI_PROVIDER=gemini

# Optional: change the model
# GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_MODEL=claude-sonnet-5-5
